# Copy to .env. Every value here is a sample for the local mock, nothing is real.

# The HR source the kit reads.
HR_SOURCE=bamboohr

# Mock BambooHR (npm run mock)
BAMBOOHR_BASE_URL=http://localhost:4010
BAMBOOHR_COMPANY=halden
BAMBOOHR_API_KEY=sat-bamboo-key-123

# The finance source. Leave empty until the Sage connector is registered, then set it to sage.
FINANCE_SOURCE=

# Sage. Fill these from your own Sage developer app and your own trial business
# (see the README). Tokens the connector obtains belong under .data/, which is
# gitignored. Nothing Sage-related ever goes into git.
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_CALLBACK_URL=http://localhost:3000/api/sage/callback
SAGE_BUSINESS_ID=

# The scheduler (npm run cron) syncs every SYNC_INTERVAL_SECONDS. The kit calls
# the sync directly and does not use CRON_SECRET; the satellite's scheduler sends
# it on every POST to its sync route. It is here so one .env works in both.
CRON_SECRET=sat-cron-secret
SYNC_INTERVAL_SECONDS=300
